msgid "A widget factory - GTK %d.%d"
msgstr "La fabrique à widgets - GTK %d.%d"

#: gtk-awf/src/awf-gtk2.c:596 gtk-awf/src/awf-gtk2.c:1318
#: gtk-awf/src/awf-gtk2.c:2218 gtk-awf/src/awf-gtk2.c:2246
#: gtk-awf/src/awf-gtk3.c:645 gtk-awf/src/awf-gtk3.c:1571
#: gtk-awf/src/awf-gtk3.c:2536 gtk-awf/src/awf-gtk3.c:2578
