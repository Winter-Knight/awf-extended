#: gtk-awf/src/awf-gtk2.c:593 gtk-awf/src/awf-gtk2.c:1271
#: gtk-awf/src/awf-gtk2.c:2015 gtk-awf/src/awf-gtk2.c:2043
#: gtk-awf/src/awf-gtk3.c:636 gtk-awf/src/awf-gtk3.c:1509
