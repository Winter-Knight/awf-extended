#: gtk-awf/src/awf-gtk2.c:601 gtk-awf/src/awf-gtk2.c:1280
#: gtk-awf/src/awf-gtk2.c:2023 gtk-awf/src/awf-gtk2.c:2051
#: gtk-awf/src/awf-gtk3.c:648 gtk-awf/src/awf-gtk3.c:1441
#: gtk-awf/src/awf-gtk3.c:2214 gtk-awf/src/awf-gtk3.c:2242
