#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_update_autotools_config:
	sed -i 's/ -eq 2/ -eq -1/g' configure.ac
	sed -i 's/ -eq 3/ -eq -1/g' configure.ac
	cp -ar data/icons/ icons-gtk4/
	for file in icons-gtk4/*/*/awf.png; do mv $$file `dirname $$file`/awf-gtk4.png; done
	for file in icons-gtk4/*/*/awf.svg; do mv $$file `dirname $$file`/awf-gtk4.svg; done
	for file in src/po/*.po; do \
		code=`basename "$$file" .po`; \
		mkdir -p locale-gtk4/$$code/LC_MESSAGES/; \
		msgfmt src/po/$$code.po -o locale-gtk4/$$code/LC_MESSAGES/awf-gtk4.mo; \
	done
